# ============================================================
# Native (nativellm) image: the Bonsai-1.7B-Q1_0 GGUF runs in-process via
# cgo (ADR-001/002/003) instead of a separate llama-server. Built elsewhere
# and shipped as a ready image -- the 1 GB Oracle deploy target never builds
# anything (S32, ADR-012).
#
# Target: amd64/x86_64, pinned to the Oracle box's real CPU baseline
# (VM.Standard.E2.1.Micro -- AMD EPYC 7551 "Naples"/Zen1: AVX2+FMA+F16C, no
# AVX-512/AVX-VNNI). Build host and target are the same architecture, so
# this is always a plain native compile -- no cross-toolchain, no QEMU
# (ADR-012 corrects an earlier ARM64 assumption, see ADR-011).
#
# Build via GitHub Actions (primary path, 16GB RAM runner -- no RAM ceiling):
# .github/workflows/build-native-image.yml (workflow_dispatch), downloads as
# a .tar.gz artifact.
#
# Build locally instead (fallback, needs real free RAM):
#   make docker-build-native
# or directly:
#   docker buildx build -f docker/Dockerfile.native -t kuromatsu:native-amd64 --load .
# ============================================================

FROM golang:1.25-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
        cmake make build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# Cache module downloads separately from source changes.
COPY go.mod go.sum ./
RUN go mod download

COPY . .

# ggml/llama.cpp is large template-heavy C++; unlimited parallelism has
# already OOM-killed this exact build (and once crashed the whole WSL VM) at
# LLAMA_BUILD_JOBS=3 on an 8 GB dev host, only stabilizing at fully serial
# -j 1 (~480 MB peak, per the E5 spike). Default to 1 for that case; the CI
# workflow (16 GB RAM runner) overrides this to a higher value since it
# isn't fighting the same ceiling.
ARG LLAMA_BUILD_JOBS=1
RUN make llama-lib-x86-64 LLAMA_BUILD_JOBS=${LLAMA_BUILD_JOBS}
RUN make build-native-x86-64
RUN make nativebench-x86-64

# ------------------------------------------------------------
# Runtime: minimal, no compiler needed.
# ------------------------------------------------------------
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates tzdata curl python3 python3-pip bash \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && pip install --no-cache-dir --break-system-packages pypdf \
    && rm -rf /var/lib/apt/lists/*

# Read automatically by the Go runtime at startup (Go >=1.19) -- keeps the
# heap from crowding out the model/KV/compute buffers inside the container's
# 900m limit (S29, NFR-001). GOMEMLIMIT is a soft limit, not a hard cap.
ENV GOMEMLIMIT=650MiB

# curl (not wget -- Debian slim has no busybox, unlike the Alpine-based
# docker/Dockerfile this mirrors) is already installed above.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -sf http://localhost:18790/health || exit 1

COPY --from=builder /src/build/kuromatsu-native-linux-amd64 /usr/local/bin/kuromatsu
COPY --from=builder /src/build/nativebench-linux-amd64 /usr/local/bin/nativebench
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
