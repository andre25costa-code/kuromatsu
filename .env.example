# Kuromatsu environment variables.
# Every value here overrides the matching key in config.json. The full list
# (one KUROMATSU_* variable per config key) is the set of env:"..." tags in
# pkg/config. Secrets can also live in .security.yml next to config.json
# instead of the environment.

# -- Paths ------------------------------------------------------------------
# Home directory for config, workspace, sessions and state (default ~/.kuromatsu).
# KUROMATSU_HOME=/var/lib/kuromatsu
# Explicit config file (default $KUROMATSU_HOME/config.json).
# KUROMATSU_CONFIG=/var/lib/kuromatsu/config.json
# Where the native model looks for <model>.gguf (default $KUROMATSU_HOME/models).
# KUROMATSU_MODELS_DIR=/var/lib/kuromatsu/models

# -- Logging ----------------------------------------------------------------
# debug | info | warn | error (default warn).
# KUROMATSU_LOG_LEVEL=info
# Also write logs to this file (~/ is expanded).
# KUROMATSU_LOG_FILE=~/.kuromatsu/kuromatsu.log

# -- Gateway ----------------------------------------------------------------
# KUROMATSU_GATEWAY_HOST=127.0.0.1
# KUROMATSU_GATEWAY_PORT=18790

# -- Telegram ---------------------------------------------------------------
# KUROMATSU_CHANNELS_TELEGRAM_TOKEN=123456:ABC...
# Restrict who can talk to the bot with "allow_from" in config.json: an empty
# list rejects everyone (fail-closed); use ["*"] for an explicitly open bot.
# KUROMATSU_CHANNELS_TELEGRAM_STREAMING_ENABLED=true
# KUROMATSU_CHANNELS_TELEGRAM_STREAMING_THROTTLE_SECONDS=2
# KUROMATSU_CHANNELS_TELEGRAM_STREAMING_MIN_GROWTH_CHARS=40

# -- Tools ------------------------------------------------------------------
# Allow shell commands requested from chat channels (off by default).
# KUROMATSU_TOOLS_EXEC_ALLOW_REMOTE=false
# Per-tool switches follow KUROMATSU_TOOLS_<TOOL>_ENABLED, e.g.:
# KUROMATSU_TOOLS_SYSMON_ENABLED=true
# Maximum results returned by tool discovery search (the older name
# KUROMATSU_MAX_SEARCH_RESULTS still works, with a deprecation warning).
# KUROMATSU_TOOLS_DISCOVERY_MAX_SEARCH_RESULTS=5

# -- Credentials and migration ----------------------------------------------
# Passphrase that decrypts enc:// values in config.json and .security.yml.
# Set by "onboard" when you choose encryption.
# KUROMATSU_KEY_PASSPHRASE=
# Private SSH key used together with the passphrase (default
# ~/.ssh/picoclaw_ed25519.key). It must live in ~/.ssh/, in KUROMATSU_HOME,
# or be pointed to by this variable.
# KUROMATSU_SSH_KEY_PATH=
# Extra skills directory, searched last (lowest priority).
# KUROMATSU_BUILTIN_SKILLS=
# Source directory for "kuromatsu migrate" (default ~/.openclaw).
# OPENCLAW_HOME=

# -- Network ----------------------------------------------------------------
# DNS servers used when the host has no resolv.conf, separated by ';'
# (default 8.8.8.8:53;1.1.1.1:53).
# KUROMATSU_DNS_SERVER=8.8.8.8:53;1.1.1.1:53

# -- Time zone --------------------------------------------------------------
# Any IANA zone name. Cron schedules ("0 9 * * *") and heartbeat timestamps
# follow it; without TZ the process uses the host zone (often UTC on a VM).
# TZ=America/Sao_Paulo

# -- Go runtime (the systemd unit sets these for a 1 GB VM) -----------------
# GOMEMLIMIT=450MiB
# GOGC=50

# -- Deploy script (scripts/deploy.sh) --------------------------------------
# ssh alias or user@host of the target VM.
# DEPLOY_HOST=my-vm
